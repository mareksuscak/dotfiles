# determine package manager and run command with it
p() {
  if [[ -f bun.lockb ]]; then
    command bun "$@"
  elif [[ -f yarn.lock ]]; then
    command yarn "$@"
  elif [[ -f package-lock.json ]]; then
    command npm "$@"
  elif [[ -f pnpm-lock.yaml ]]; then
    command pnpm "$@"
  elif [[ -f Gemfile ]]; then
    command bundle "$@"
  elif [[ -f Cargo.toml ]]; then
    command cargo "$@"
  elif [[ -f mix.lock ]]; then
    command mix "$@"
  elif [[ -f go.mod ]]; then
    command go "$@"
  elif [[ -f composer.lock ]]; then
    command composer "$@"
  elif [[ -f requirements.txt ]]; then
    command pip "$@"
  else
    yarn "$@"
  fi
}
